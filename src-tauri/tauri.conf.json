{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Job Tracker",
  "version": "0.1.0",
  "identifier": "com.jobtracker.local",
  "build": {
    "frontendDist": "../desktop/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ./desktop run dev",
    "beforeBuildCommand": "npm --prefix ./desktop run build"
  },
  "app": {
    "windows": [
      {
        "title": "Job Tracker",
        "width": 1180,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
