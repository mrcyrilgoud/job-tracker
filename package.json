{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run tauri:dev",
    "tauri:dev": "cargo tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "cargo tauri build --config src-tauri/tauri.conf.json",
    "jobs": "cargo run --manifest-path src-tauri/Cargo.toml -- --run-jobs",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:desktop": "npm --prefix desktop run test",
    "jobs:install": "tsx scripts/install-launchd.ts",
    "app:rebuild": "tsx scripts/rebuild-app.ts",
    "hooks:install": "tsx scripts/install-git-hooks.ts"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
