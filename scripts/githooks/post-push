#!/usr/bin/env bash
# post-push: background-rebuild Job Tracker when app-relevant paths changed.
# Installed via: npm run hooks:install  (copies into .git/hooks/post-push)

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "$REPO_ROOT"

RELEVANT=0

while read -r local_ref local_sha remote_ref remote_sha; do
  # Delete / no local tip
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi

  # Collect changed paths for this ref update.
  # New branch / first push (empty remote sha): do NOT use `git diff <sha>` —
  # that compares the working tree to the tip and misses a clean post-push tree.
  # Use commits on local_sha that are not on any remote instead.
  if [[ "$remote_sha" =~ ^0+$ ]]; then
    changed="$(
      git log --pretty=format: --name-only "$local_sha" --not --remotes -- \
        desktop/ \
        src-tauri/ \
        package.json \
        package-lock.json \
        2>/dev/null || true
    )"
  else
    changed="$(
      git diff --name-only "${remote_sha}..${local_sha}" -- \
        desktop/ \
        src-tauri/ \
        package.json \
        package-lock.json \
        2>/dev/null || true
    )"
  fi

  if [[ -n "${changed//[[:space:]]/}" ]]; then
    RELEVANT=1
    break
  fi
done

if [[ "$RELEVANT" -eq 0 ]]; then
  exit 0
fi

mkdir -p data
echo "Job Tracker rebuild started in background (data/rebuild.log)"
nohup npm run app:rebuild -- --background >> data/rebuild.log 2>&1 &
