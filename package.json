{
  "name": "job-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run tauri:dev",
    "tauri:dev": "cargo tauri dev --config src-tauri/tauri.conf.json",
    "tauri:build": "cargo tauri build --config src-tauri/tauri.conf.json",
    "jobs": "cargo run --manifest-path src-tauri/Cargo.toml -- --run-jobs",
    "desktop:dev": "npm --prefix desktop run dev",
    "desktop:build": "npm --prefix desktop run build",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:vitest": "vitest run",
    "jobs:install": "tsx scripts/install-launchd.ts",
    "next:dev": "next dev",
    "next:build": "next build",
    "lint": "eslint",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "googleapis": "^171.4.0",
    "keytar": "^7.9.0",
    "next": "16.2.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "uuid": "^14.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/keytar": "^4.4.2",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
